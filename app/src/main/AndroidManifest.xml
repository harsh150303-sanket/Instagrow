<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="InstaGrow"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstaGrow">
        <activity
            android:name=".ui.BestTimeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BioGeneratorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.HashtagGeneratorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CaptionGeneratorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
